# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnp.*

# ── Expo ──────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Native build output ───────────────────────────────────────────────────────
/ios
/android
.kotlin/
*.orig.*

# ── Signing / certificates ────────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── Metro ─────────────────────────────────────────────────────────────────────
.metro-health-check*

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# ── Debug / logs ──────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.expo/dev/logs/

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
